# --- Database ---
# Note: host port 55433 (not 5432) to avoid clashing with other local Postgres containers.
# Inside docker-compose, services reach it via postgres:5432 (compose sets this automatically).
DATABASE_URL=postgresql+asyncpg://aivis:aivis@localhost:55433/aivis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible / MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=aivis
S3_SECRET_ACCESS_KEY=aivis12345
S3_BUCKET_RAW=aivis-datasets-raw
S3_BUCKET_PROCESSED=aivis-datasets-processed
S3_BUCKET_EXPORTS=aivis-exports
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=200

# --- Observability ---
SENTRY_DSN=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
